// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║              ZELLIJ LAYOUT - NERV COMMAND CENTER                              ║
// ║                    High-Density Multi-Pane Layout                             ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝

layout {
    // Tab 1: Command Center - Main monitoring hub
    tab name="⚡ Command" {
        pane size=25 borderless=false {
            // Top row - System stats (25% height)
            pane size=33 {
                pane {
                    command "bash -c 'while true; do clear; echo \"╔════════════════════════════════════════╗\"; echo \"║  NERV COMMAND CENTER - SYSTEM STATUS   ║\"; echo \"╚════════════════════════════════════════╝\"; echo \"\"; hostname; echo \"\"; uptime; echo \"\"; free -h | grep -E \"Mem|Swap\"; echo \"\"; df -h / /home 2>/dev/null | tail -2; sleep 1; done'"
                }
            }
            pane size=34 {
                pane {
                    command "bash -c 'while true; do clear; echo \"╔════════════════════════════════════════╗\"; echo \"║  CPU TEMPERATURE & FAN STATUS        ║\"; echo \"╚════════════════════════════════════════╝\"; echo \"\"; sensors 2>/dev/null | head -20 || echo \"sensors not available\"; sleep 2; done'"
                }
            }
            pane size=33 {
                pane {
                    command "bash -c 'while true; do clear; echo \"╔════════════════════════════════════════╗\"; echo \"║  NETWORK ACTIVITY                    ║\"; echo \"╚════════════════════════════════════════╝\"; echo \"\"; cat /proc/net/dev | grep -E \"eth|wlan|enp|wl\" | head -4; echo \"\"; ip addr 2>/dev/null | grep -E \"inet \" | head -4; sleep 1; done'"
                }
            }
        }
        pane size=50 borderless=false {
            // Middle row - Main shell + logs (50% height)
            pane size=70 {
                // Main shell (70% width)
                pane
            }
            pane size=30 {
                // System logs (30% width)
                pane {
                    command "bash -c 'tail -n 100 /var/log/syslog 2>/dev/null || journalctl -n 100 --no-pager 2>/dev/null || echo \"Log access requires permissions\"'"
                }
            }
        }
        pane size=25 borderless=false {
            // Bottom row - Process monitor (25% height)
            pane size=50 {
                pane {
                    command "htop"
                }
            }
            pane size=50 {
                pane {
                    command "bash -c 'while true; do clear; echo \"╔════════════════════════════════════════╗\"; echo \"║  TOP PROCESSES BY MEMORY             ║\"; echo \"╚════════════════════════════════════════╝\"; echo \"\"; ps aux --sort=-%mem | head -12; sleep 2; done'"
                }
            }
        }
    }

    // Tab 2: Development Workspace
    tab name="💻 Dev" {
        pane size=100 borderless=false {
            pane size=50 {
                pane size=50 {
                    pane
                }
                pane size=50 {
                    pane
                }
            }
            pane size=50 {
                pane size=33 {
                    pane {
                        command "bash -c 'echo \"╔════════════════════════════════════════╗\"; echo \"║  QUICK COMMANDS                      ║\"; echo \"╚════════════════════════════════════════╝\"; echo \"\"; echo \"git status\"; echo \"git log --oneline -10\"; echo \"npm run dev\"; echo \"cargo build\"; echo \"\"; echo \"Press Ctrl+p to navigate\"'"
                    }
                }
                pane size=33 {
                    pane {
                        command "bash -c 'while true; do clear; echo \"╔════════════════════════════════════════╗\"; echo \"║  GIT STATUS                          ║\"; echo \"╚════════════════════════════════════════╝\"; echo \"\"; git status 2>/dev/null || echo \"Not a git repo\"; sleep 5; done'"
                    }
                }
                pane size=34 {
                    pane {
                        command "bash -c 'while true; do clear; echo \"╔════════════════════════════════════════╗\"; echo \"║  SYSTEM RESOURCES                    ║\"; echo \"╚════════════════════════════════════════╝\"; echo \"\"; free -h; echo \"\"; df -h / | tail -1; sleep 3; done'"
                    }
                }
            }
        }
    }

    // Tab 3: Full Monitoring
    tab name="📊 Monitor" {
        pane size=100 {
            pane {
                command "btop"
            }
        }
    }

    // Tab 4: File Operations
    tab name="📁 Files" {
        pane size=50 {
            pane {
                command "bash -c 'lf 2>/dev/null || ranger 2>/dev/null || exec bash'"
            }
        }
        pane size=50 {
            pane {
                command "bash -c 'echo \"=== Directory Tree ===\"; tree -L 2 -I \"node_modules|.git|target\" 2>/dev/null || find . -maxdepth 2 -type d | head -30'"
            }
        }
    }
}
