// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║                   ZELLIJ THEME - NERV TERMINAL                                ║
// ║                    Cyberpunk Solarized Fusion                                 ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝
// HIGH CONTRAST - Matching web version appearance
// Tab selector uses EVA green (#44FF88) from i3 config

themes {
    nerv-terminal {
        // Base colors - matching web version contrast
        fg 220 220 220      // Bright white-gray (main text - high contrast)
        bg 50 50 55         // Dark gray (matching web version)

        // Core palette - high contrast colors
        black 30 30 35      // Dark gray (borders)
        red 255 85 85       // Bright red (errors)
        green 68 255 136    // EVA green #44FF88 (tab selector - matches i3 theme)
        yellow 255 230 100  // Bright yellow (warnings)
        blue 100 160 255    // Bright blue
        magenta 255 100 255 // Bright magenta (focus indicator)
        cyan 100 255 255    // Bright cyan (accents)
        white 255 255 255   // Pure white (maximum contrast)

        // Extended colors
        orange 255 150 50   // Bright orange
        lime 150 255 100    // Bright lime
        pink 255 100 180    // Hot pink
        violet 200 180 255  // Light violet
    }
}
