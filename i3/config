###################
#   RESIZE MODE   #
###################

mode "resize" {
    # These bindings trigger as soon as you enter the resize mode
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym ñ resize grow width 10 px or 10 ppt

    # Same bindings, but for the arrow keys
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Fine-tune resizing (5px increments)
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym i resize grow height 5 px or 5 ppt
    bindsym comma resize shrink height 5 px or 5 ppt
    bindsym period resize grow width 5 px or 5 ppt

    # Back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

######################################
# KEYBINDINGS FOR DIFFERENT ACTIONS #
######################################

# Start a terminal (keeping your alacritty choice)
bindsym $mod+Return exec --no-startup-id alacritty

# Kill focused window
bindsym $mod+Shift+q kill

# Exit menu
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu

# Lock the system (removed - now configured in SCREEN LOCK section)

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace (preserves your layout/session)
bindsym $mod+Shift+r restart

# Keybinding hint in fancy rofi
bindsym F1 exec --no-startup-id ~/.config/i3/scripts/keyhint-2

# Backlight control
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh brightness_up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh brightness_down

# Change focus (keeping your custom layout)
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+b focus up
bindsym $mod+o focus right

# Alternative cursor key focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+b move up
bindsym $mod+Shift+l move right

# Alternative cursor key movement
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split in horizontal/vertical orientation
bindsym $mod+h split h
bindsym $mod+v split v

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+g layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Focus the parent container
bindsym $mod+a focus parent

# Open new empty workspace
bindsym $mod+Shift+n exec --no-startup-id ~/.config/i3/scripts/empty_workspace

# Quick app launchers
bindsym $mod+F1 exec --no-startup-id alacritty
bindsym $mod+F2 exec --no-startup-id zen-browser
bindsym $mod+F3 exec --no-startup-id thunar
bindsym $mod+F4 exec --no-startup-id zed

# Screenshot utilities - Use dedicated mode to avoid conflicts
# $mod+Print enters screenshot mode for consistent flameshot behavior
# (Direct Print bindings removed to prevent conflicts with other apps)

# Clipboard manager (cliphist + rofi)
bindsym $mod+Shift+x exec --no-startup-id ~/.config/i3/scripts/clipboard-manager --show
bindsym $mod+Control+v exec --no-startup-id ~/.config/i3/scripts/clipboard-manager --delete
bindsym $mod+Control+Shift+v exec --no-startup-id ~/.config/i3/scripts/clipboard-manager --clear

# Wallpaper manager (swww) - for static images
bindsym $mod+F7 exec --no-startup-id ~/.config/i3/scripts/wallpaper-manager --next
bindsym $mod+Shift+F7 exec --no-startup-id ~/.config/i3/scripts/wallpaper-manager --select

# Video wallpaper (xwinwrap + mpv) - for animated/video wallpapers
# Using F9 to avoid conflict with keyboard layout toggle (F6)
bindsym $mod+F9 exec --no-startup-id ~/.config/i3/scripts/video-wallpaper --next
bindsym $mod+Shift+F9 exec --no-startup-id ~/.config/i3/scripts/video-wallpaper --select
bindsym $mod+Control+F9 exec --no-startup-id ~/.config/i3/scripts/video-wallpaper --stop

# Video wallpaper with auto color extraction (hellwal/matugen)
bindsym $mod+Mod1+F9 exec --no-startup-id ~/.config/i3/scripts/video-wallpaper --next-colors
bindsym $mod+Mod1+Shift+F9 exec --no-startup-id ~/.config/i3/scripts/wallpaper-colors --current

# Apply wallpaper colors to i3 theme (i3bar, window borders)
bindsym $mod+Mod1+F10 exec --no-startup-id ~/.config/i3/scripts/apply-wallpaper-colors-i3 --apply

# System monitor (floating terminal with bpytop/bottom)
bindsym $mod+F8 exec --no-startup-id ~/.config/i3/scripts/system-monitor bpytop

# Center focused window (useful for floating windows)
bindsym $mod+Shift+o exec --no-startup-id ~/.config/i3/scripts/center_window

# Move window to center of screen
bindsym $mod+Control+c move position center

# Quick notes - Add clipboard content to notes
bindsym $mod+F5 exec --no-startup-id ~/.config/i3/scripts/quick-notes --add && notify-send " Note Added" "$(xclip -selection clipboard -o 2>/dev/null | head -c 50)..."

# Move workspace to output (multi-monitor)
bindsym $mod+Shift+F1 move workspace to output HDMI-0
bindsym $mod+Shift+F2 move workspace to output DP-0
bindsym $mod+Shift+F3 move workspace to output DP-4

# Quick workspace navigation
bindsym $mod+semicolon workspace prev
bindsym $mod+apostrophe workspace next

# Exit confirmation dialog
bindsym $mod+Shift+Delete exec --no-startup-id i3-nagbar -t warning -m 'You pressed the exit key. Press OK to exit i3.' -b OK 'i3-msg exit'

###################
# MULTIMEDIA KEYS #
###################

# Volume control
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_down

# Granular volume control
bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id amixer -D pulse sset Master 1%+ && pkill -RTMIN+1 i3blocks
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id amixer -D pulse sset Master 1%- && pkill -RTMIN+1 i3blocks

# Mute
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_mute

# Mic mute toggle
bindsym XF86AudioMicMute exec amixer sset Capture toggle

# Audio control
bindsym XF86AudioPlay exec --no-startup-id playerctl play
bindsym XF86AudioStop exec --no-startup-id playerctl pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Redirect sound to headphones
bindsym $mod+p exec --no-startup-id /usr/local/bin/switch-audio-port

# Power Profiles menu switcher (rofi)
bindsym $mod+Shift+p exec --no-startup-id ~/.config/i3/scripts/power-profiles

##########################################
# CONFIGURATION FOR WORKSPACE BEHAVIOUR #
##########################################

# Define names for default workspaces with Evangelion-inspired icons
set $ws1 "1:  NERV"
set $ws2 "2:  CODE"
set $ws3 "3:  TERM"
set $ws4 "4:  FILES"
set $ws5 "5:  MEDIA"
set $ws6 "6:  COMMS"
set $ws7 "7:  SYNC"
set $ws8 "8:  MONITOR"
set $ws9 "9:  GAMES"
set $ws10 "10:  MISC"

# Use workspaces on different displays
workspace $ws1 output HDMI-0
workspace $ws2 output DP-0
workspace $ws3 output DP-4

# ─────────────────────────────────────────────────────────────────────────────
#  APP-SPECIFIC WORKSPACE ASSIGNMENTS
# ─────────────────────────────────────────────────────────────────────────────

# Code workspace (DP-0)
for_window [class="Code" class="Code - OSS" class="Cursor" class="zed"] move container to workspace $ws2

# Terminal workspace (DP-4)
for_window [class="Alacritty" class="Kitty" class="Ghostty"] move container to workspace $ws3

# Files workspace
for_window [class="Thunar" class="Nautilus" class="Dolphin"] move container to workspace $ws4

# Media workspace
for_window [class="Spotify" class="vlc" class="mpv"] move container to workspace $ws5

# Comms workspace
for_window [class="vesktop" class="Discord" class="discord" class="Slack" class="teams-for-linux"] move container to workspace $ws6
for_window [class="Thunderbird" class="Geary"] move container to workspace $ws6

# Browser (follows focus, but default to CODE workspace)
for_window [class="google-chrome" class="Brave-browser" class="firefox" class="zen-browser"] move container to workspace $ws2

# Monitoring/Sync workspace
for_window [class="Grafana" class="htop" class="btop"] move container to workspace $ws8

# Games workspace
for_window [class="steam" class="lutris" class="heroic"] move container to workspace $ws9

# ─────────────────────────────────────────────────────────────────────────────
#  AUTOMATIC FOCUS FOR SPECIFIC APPS
# ─────────────────────────────────────────────────────────────────────────────

# Automatic set focus new window if it opens on another workspace
for_window [class=Xfce4-terminal] focus
for_window [class=(?i)zen-browser] focus
for_window [class=Thunar] focus

# KeePassXC - Start minimized to system tray (no permanent window)
for_window [class="keepassxc"] move scratchpad

##############
# COMPOSITOR #
##############

# Picom compositor - OPTIMIZED for video wallpapers
# - use-damage = false: Better performance with videos
# - Excludes mpv/xwinwrap from effects
# - Faster fade animations
exec_always --no-startup-id picom --config ~/.config/picom/picom-optimized.conf

#############################################
# AUTOSTART APPLICATIONS/SERVICES ON LOGIN #
#############################################

# Get auth work with polkit-gnome
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id xfsettingsd --daemon --replace --disable-compositor

# Dex execute .desktop files + apps using /etc/xdg/autostart
exec --no-startup-id dex --autostart --environment i3

# Set wallpaper with swww (animated transitions) - for static images
# exec_always --no-startup-id ~/.config/i3/scripts/wallpaper-manager --init

# Set video wallpaper on all monitors (xwinwrap + mpv)
# Runs on startup and config reload
exec_always --no-startup-id sleep 2 && ~/.config/i3/scripts/video-wallpaper --next

# Auto-restore video wallpaper on monitor hotplug (optional)
# Uncomment if you want wallpapers to auto-adjust when plugging/unpluging monitors
# bindsym XF86DisplayMode exec --no-startup-id ~/.config/i3/scripts/video-wallpaper --next

# Disable power saving for consistent display
exec --no-startup-id xset -dpms

# Desktop notifications
exec --no-startup-id /usr/bin/dunst

# Autotiling script for automatic layout management
exec_always --no-startup-id autotiling

# Autostart applications
exec --no-startup-id sleep 3 && vesktop
exec --no-startup-id sleep 3 && thunderbird

