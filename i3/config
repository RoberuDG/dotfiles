#######################
# SYSTEM CORE CONFIG  #
#######################

# Font for window titles and UI elements
font pango:Iosevka Nerd Font Bold 12

# Set the mod key to Super (Windows key)
set $mod Mod4

#####################
# WORKSPACE LAYOUT  #
#####################

# Default i3 tiling mode with gaps for that sleek look
workspace_layout default

# Inner gaps for breathing room between windows
gaps inner 16
# Outer gaps for screen edge spacing
gaps outer 20

# Smart gaps - only show gaps when multiple containers
smart_gaps on

# Smart borders - only show borders when multiple containers
smart_borders on

# Window borders configuration - thicker for that EVA aesthetic
default_border pixel 3
default_floating_border pixel 3

# Hide edge borders when only one window
hide_edge_borders smart

# Window title alignment
title_align center

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# Focus urgency handling
focus_on_window_activation smart

#####################
#  CUSTOM MODES     #
#####################

# App Launcher Mode - EVA Style
mode "launcher" {
    bindsym f exec --no-startup-id rofi -show drun -config ~/.config/rofi/config.rasi; mode "default"
    bindsym w exec --no-startup-id rofi -show window -config ~/.config/rofi/rofidmenu.rasi; mode "default"
    bindsym t exec --no-startup-id alacritty; mode "default"
    bindsym g exec --no-startup-id google-chrome-stable; mode "default"
    bindsym d exec --no-startup-id discord; mode "default"
    bindsym s exec --no-startup-id spotify; mode "default"
    bindsym v exec --no-startup-id vesktop; mode "default"
    bindsym e exec --no-startup-id thunar; mode "default"
    bindsym c exec --no-startup-id code; mode "default"
    bindsym m exec --no-startup-id thunderbird; mode "default"

    # Back to normal
    bindsym Escape mode "default"
    bindsym Return mode "default"
}

# Screenshot Mode - flameshot focused
# Enter with $mod+Print, then press:
#   s - flameshot gui (select area)
#   f - flameshot full (full screen)
#   w - flameshot screen (active workspace)
#   r - grim + slurp (wayland-style region)
mode "screenshot" {
    bindsym s exec --no-startup-id flameshot gui; mode "default"
    bindsym f exec --no-startup-id flameshot full -p ~/Pictures/Screenshots; mode "default"
    bindsym w exec --no-startup-id flameshot screen -p ~/Pictures/Screenshots; mode "default"
    bindsym r exec --no-startup-id grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png; mode "default"
    # Default action (Enter key) - flameshot gui
    bindsym Return exec --no-startup-id flameshot gui; mode "default"
    bindsym Escape mode "default"
}

# Workspace Move Mode
mode "movetows" {
    bindsym 1 move container to workspace $ws1, mode "default"
    bindsym 2 move container to workspace $ws2, mode "default"
    bindsym 3 move container to workspace $ws3, mode "default"
    bindsym 4 move container to workspace $ws4, mode "default"
    bindsym 5 move container to workspace $ws5, mode "default"
    bindsym 6 move container to workspace $ws6, mode "default"
    bindsym 7 move container to workspace $ws7, mode "default"
    bindsym 8 move container to workspace $ws8, mode "default"
    bindsym 9 move container to workspace $ws9, mode "default"
    bindsym 0 move container to workspace $ws10, mode "default"
    bindsym Escape mode "default"
    bindsym Return mode "default"
}

# Gaps controls - alternative bindings (use F-keys to avoid conflicts)
bindsym $mod+Control+0 gaps inner current set 0
bindsym $mod+Control+1 gaps inner current set 5
bindsym $mod+Control+2 gaps inner current set 10
bindsym $mod+ControlI +3 gaps inner current set 15
bindsym $mod+Control+4 gaps inner current set 20
bindsym $mod+Control+5 gaps inner current set 25
bindsym $mod+Control+u gaps inner current reset

# Scratchpad Mode - Quick scratchpad access
mode "scratchpad" {
    bindsym 1 scratchpad show, mode "default"
    bindsym 2 scratchpad show, mode "default"
    bindsym 3 scratchpad show, mode "default"
    bindsym Escape mode "default"
    bindsym Return mode "default"
}

bindsym $mod+z mode "launcher"
bindsym $mod+Print mode "screenshot"
bindsym $mod+Shift+m mode "movetows"
bindsym $mod+Shift+g mode "gaps"
bindsym $mod+Shift+s mode "scratchpad"

