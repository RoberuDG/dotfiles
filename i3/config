# Shows: [icon] app_name - title
for_window [class="Alacritty"] title_format "<span foreground='#44FF88'></span> %title"
for_window [class="Code" class="Code - OSS"] title_format "<span foreground='#8A33FF'></span> %title"
for_window [class="google-chrome" class="Brave-browser"] title_format "<span foreground='#FF5577'></span> %title"
for_window [class="Thunar"] title_format "<span foreground='#44FF88'></span> %title"
for_window [class="firefox"] title_format "<span foreground='#FFB347'></span> %title"
for_window [class="zen-browser"] title_format "<span foreground='#FFB347'></span> %title"
for_window [class="vesktop" class="Discord"] title_format "<span foreground='#8A33FF'></span> %title"
for_window [class="Spotify"] title_format "<span foreground='#44FF88'></span> %title"
for_window [class="Thunderbird"] title_format "<span foreground='#8A33FF'></span> %title"
for_window [class="vlc"] title_format "<span foreground='#FF5577'></span> %title"
for_window [class="mpv"] title_format "<span foreground='#FF5577'></span> %title"
for_window [class="steam"] title_format "<span foreground='#5D9CEC'></span> %title"
for_window [class="Cursor"] title_format "<span foreground='#8A33FF'></span> %title"
for_window [class="zed"] title_format "<span foreground='#8A33FF'></span> %title"
for_window [class="Kitty"] title_format "<span foreground='#44FF88'></span> %title"
for_window [class="Ghostty"] title_format "<span foreground='#44FF88'></span> %title"

####################
# APPLICATION MENU #
####################

# Rofi application launcher
bindsym $mod+d exec --no-startup-id rofi -modi drun -show drun \
        -config ~/.config/rofi/config.rasi

# Rofi window switcher
bindsym $mod+t exec --no-startup-id rofi -show window \
        -config ~/.config/rofi/rofidmenu.rasi

####################
#    SCRATCHPAD    #
####################

# Make the currently focused window a scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the first scratchpad window
bindsym $mod+minus scratchpad show

####################
# POLYBAR LAUNCH   #
####################

# Start Polybar on all monitors
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Monitor hotplug watcher - restarts polybar on monitor changes
exec_always --no-startup-id ~/.config/polybar/monitor-watcher.sh

####################
# AUDIO VISUALIZER #
####################

# Setup CAVA FIFO for audio visualization
exec --no-startup-id mkfifo /tmp/cava.fifo
exec --no-startup-id cava

####################
#  KEYBOARD LAYOUT #
####################

# Set up multiple keyboard layouts (English + Spanish)
exec --no-startup-id setxkbmap -layout us,es -option grp:alt_caps_toggle

# Keyboard layout switcher keybinding
bindsym $mod+F6 exec --no-startup-id ~/.config/i3/scripts/keyboard-toggle --toggle

# Clipboard manager service
exec --no-startup-id cliphist service

# Start polybar at startup
exec --no-startup-id ~/.config/polybar/monitor-hotplug.sh

# Polybar sleep/resume monitor (detects suspend via boot time change)
exec --no-startup-id ~/.config/polybar/polybar-sleep-monitor.sh &

####################
#   SCREEN LOCK    #
####################

# Auto screen lock with xss-lock using EVA styled multi-monitor lock screen
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/scripts/eva-lock-multi

# Manual lock keybinding
bindsym $mod+l exec --no-startup-id ~/.config/i3/scripts/eva-lock-multi

####################
# EXTRA FEATURES   #
####################

# Enable automatic back and forth workspace switching
workspace_auto_back_and_forth yes

# Focus follows mouse (with 500ms delay to prevent accidental switches)
focus_follows_mouse yes

# Wrapping when reaching screen edges
force_focus_wrapping yes

# Mouse warping - move cursor to focused window
mouse_warping output

# Popup handling during fullscreen
popup_during_fullscreen smart

# Notification controls (dunst)
bindsym $mod+period exec --no-startup-id dunstctl history-pop
bindsym $mod+comma exec --no-startup-id dunstctl close
bindsym $mod+Shift+period exec --no-startup-id dunstctl history-clear
bindsym $mod+Shift+comma exec --no-startup-id dunstctl clear-all

