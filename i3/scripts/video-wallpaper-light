#!/usr/bin/env bash
VIDEO_DIR="$HOME/Pictures/Wallpapers/EVA"
PID_DIR="/tmp/video_wallpapers"
mkdir -p "$PID_DIR"

kill_wallpapers() {
    for pid_file in "$PID_DIR"/*.pid; do
        [ -f "$pid_file" ] && kill $(cat "$pid_file") 2>/dev/null && rm -f "$pid_file"
    done
    pkill -f "xwinwrap.*mpv" 2>/dev/null
    sleep 0.3
}

set_wallpaper_on_monitor() {
    local monitor="$1"
    local resolution="$2"
    local video="$3"
    [ ! -f "$video" ] && return 1
    local pid_file="$PID_DIR/${monitor}.pid"
    [ -f "$pid_file" ] && kill $(cat "$pid_file") 2>/dev/null && rm -f "$pid_file"
    xwinwrap -g "$resolution" -b -nf -ov -sub "%WID" -- \
        mpv --no-config "--wid=%WID" --loop --no-audio \
            --hwdec=auto --vd-lavc-threads=2 \
            --no-osc --no-osd-bar --osd-level=0 \
            --input-default-bindings=no "$video" &
    echo $! > "$pid_file"
    disown
}

main() {
    echo "Setting LIGHTWEIGHT video wallpaper..."
    local monitor_file=$(mktemp)
    xrandr --query | grep " connected" | awk '{print $1, $3}' > "$monitor_file"
    kill_wallpapers
    local video="$1"
    if [ -z "$video" ] || [ ! -f "$video" ]; then
        video=$(find "$VIDEO_DIR" -type f -name "*.mp4" | shuf -n 1)
    fi
    while read -r monitor resolution; do
        set_wallpaper_on_monitor "$monitor" "$resolution" "$video"
    done < "$monitor_file"
    rm -f "$monitor_file"
    sleep 1
    notify-send "🖼️ Lightweight Wallpaper" "Set" -t 2000
}

case "$1" in
    --next|next) main "" ;;
    --kill|stop) kill_wallpapers ;;
    *) [ -f "$1" ] && main "$1" || main "" ;;
esac
