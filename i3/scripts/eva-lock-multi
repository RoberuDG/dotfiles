#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║                    EVA UNIT-01 MULTI-MONITOR LOCK SCREEN                      ║
# ║              Captures current screen (with videos) and applies blur           ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# Colors
COLOR_TEXT="#44FF88"
COLOR_DATE="#B4BEFE"
COLOR_PURPLE="#8A33FF"
COLOR_BG="#0D0B14"

TIME=$(date +"%H:%M:%S")
DATE=$(date +"%A, %d %B %Y")

# Kill any existing lock screens
killall i3lock 2>/dev/null

# Get total desktop size
TOTAL_WIDTH=$(xrandr --query | grep " connected" | awk '{print $3}' | cut -d'+' -f2 | awk -F'x' '{sum+=$1} END {print sum}')
MAX_HEIGHT=$(xrandr --query | grep " connected" | awk '{print $3}' | awk -F'x' '{print $2}' | sort -n | tail -1)

[ -z "$TOTAL_WIDTH" ] && TOTAL_WIDTH=6400
[ -z "$MAX_HEIGHT" ] && MAX_HEIGHT=1080

# Create temporary lock image
LOCK_IMG="/tmp/lock_screen_$$.png"
BLURRED_IMG="/tmp/lock_blur_$$.png"

# CAPTURE SCREEN FIRST (with videos visible!)
if command -v scrot &> /dev/null; then
    # Capture immediately - videos are still visible
    scrot -d 0.1 "$LOCK_IMG" 2>/dev/null
    
    if [ -f "$LOCK_IMG" ]; then
        # Apply STRONG blur (0x30 for more blur)
        convert "$LOCK_IMG" -blur 0x30 "$BLURRED_IMG" 2>/dev/null
        
        # Add dark overlay
        convert "$BLURRED_IMG" \
            -fill "rgba(13,11,20,0.4)" \
            -draw "rectangle 0,0 ${TOTAL_WIDTH},${MAX_HEIGHT}" \
            -gravity center \
            -pointsize $((TOTAL_WIDTH / 45)) \
            -fill "$COLOR_TEXT" \
            -font "Iosevka Nerd Font-Bold" \
            -annotate +0+0 "$TIME" \
            -pointsize $((TOTAL_WIDTH / 120)) \
            -fill "$COLOR_DATE" \
            -annotate +0+60 "$DATE" \
            -fill "$COLOR_PURPLE" \
            -pointsize $((TOTAL_WIDTH / 200)) \
            -annotate -$(($TOTAL_WIDTH/25)),$(($MAX_HEIGHT/3)) "🔒 EVA UNIT-01" \
            "$LOCK_IMG" 2>/dev/null
        
        rm -f "$BLURRED_IMG"
    fi
fi

# Fallback if capture failed
if [ ! -f "$LOCK_IMG" ]; then
    convert -size ${TOTAL_WIDTH}x${MAX_HEIGHT} xc:"$COLOR_BG" \
        -gravity center \
        -pointsize $((TOTAL_WIDTH / 45)) \
        -fill "$COLOR_TEXT" \
        -annotate +0+0 "$TIME" \
        -pointsize $((TOTAL_WIDTH / 120)) \
        -fill "$COLOR_DATE" \
        -annotate +0+60 "$DATE" \
        "$LOCK_IMG" 2>/dev/null
fi

# Lock with the image
if [ -f "$LOCK_IMG" ]; then
    i3lock -i "$LOCK_IMG" \
        --inside-color="$COLOR_BG" \
        --ring-color="$COLOR_PURPLE" \
        --line-color="$COLOR_BG" \
        --separator-color="$COLOR_PURPLE" \
        --key-hl-color="$COLOR_TEXT" \
        --ring-ver-color="$COLOR_PURPLE" \
        --ring-wrong-color="#FF5577" \
        --verif-color="$COLOR_TEXT" \
        --wrong-color="#FF5577" \
        -n 2>/dev/null
fi

# Cleanup
sleep 1
rm -f "$LOCK_IMG" "$BLURRED_IMG" 2>/dev/null
